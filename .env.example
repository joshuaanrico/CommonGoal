# Firebase config for CommonGoal.
#
# Copy this file to .env.local and fill in your own project's values from:
# Firebase console, Project settings, Your apps, SDK setup and configuration.
#
# .env.local is gitignored, never commit it. This file is committed so the
# variable names are visible without exposing a real project.
#
# Restart the dev server after editing .env.local, it only loads at startup.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Base URL of the CommonGoal Cloud Functions (not a secret). Optional, the app falls back to this value.
VITE_FUNCTIONS_BASE_URL=https://australia-southeast2-commongoal-4a77b.cloudfunctions.net
