# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Restart npm run dev after changing it.

# Firebase: console > Project settings > Your apps.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Cloud Functions base URL. Optional.
VITE_FUNCTIONS_BASE_URL=https://australia-southeast2-commongoal-4a77b.cloudfunctions.net

# Mapbox public token (starts with pk.). https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_public_token_here

# PrimeUI license key (free for students). Removes the red license badge.
VITE_PRIMEUI_LICENSE=your_primeui_license_key_here
