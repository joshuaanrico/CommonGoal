# Firebase configuration for CommonGoal.
#
# Copy this file to .env.local and fill in the values from your own Firebase project:
# Firebase console, Project settings, Your apps, SDK setup and configuration, Config.
#
# .env.local is gitignored and must never be committed. This file is committed so the
# required variable names are visible without exposing a project.
#
# Vite only exposes variables prefixed with VITE_ to client code.
# Restart the dev server after changing .env.local, it is only read at startup.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
