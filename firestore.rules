// Firestore security rules for CommonGoal (BR C.4).
// This is the server side check. The router guard in the app is just for
// user experience, someone editing client code can skip it, so the real
// rules live here.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles, and where the role field lives.
    match /users/{uid} {

      // Read your own profile. Admins can read anyone's.
      allow get: if isOwner(uid) || isAdmin();

      // Only admins can list every user, this backs the admin console table.
      allow list: if isAdmin();

      // Signing up always creates a member, never an admin. Admins are added
      // by hand in the Firebase console. hasOnly() also blocks extra fields.
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'member'
                    && request.resource.data.keys().hasOnly(['email', 'fullName', 'role', 'createdAt']);

      // Only admins can edit or delete a profile, and even they cannot change a role from the
      // browser. Roles change only through the setUserRole Cloud Function, which logs it.
      allow update: if isAdmin()
                    && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // Per-route average and count, written only by the onRatingWritten Cloud Function
    // (the Admin SDK skips these rules). Public read, no client writes at all.
    match /routeStats/{routeId} {
      allow read: if true;
      allow write: if false;
    }

    // Audit log of role changes, written by setUserRole. Admins can read it.
    match /roleChanges/{changeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Route ratings. Doc id is {uid}_{routeId}, so one user can only ever
    // have one rating per route.
    match /ratings/{ratingId} {

      // Scores are public, so anyone can see the average, signed in or not.
      allow read: if true;

      allow create, update: if isSignedIn()
                    // You can only write a rating under your own uid.
                    && request.auth.uid == request.resource.data.uid
                    // Doc id must match owner and route.
                    && ratingId == request.auth.uid + '_' + string(request.resource.data.routeId)
                    // Score must be a whole number 1 to 5.
                    && request.resource.data.score is int
                    && request.resource.data.score >= 1
                    && request.resource.data.score <= 5
                    // Comment capped at 300 characters.
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 300;

      // Only admins can delete a rating.
      allow delete: if isAdmin();
    }

    // Everything else is denied by default.
  }
}
