// Firestore security rules (BR C.4).
// This is the real security. Router guards in the app are only for user experience.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles (this is where the role is stored).
    match /users/{uid} {
      // Read your own profile. Admins can read all.
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Sign up always makes a member. No extra fields allowed.
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'member'
                    && request.resource.data.keys().hasOnly(['email', 'fullName', 'role', 'createdAt']);

      // Admins can edit a profile but not the role. Roles change only in the setUserRole function.
      allow update: if isAdmin()
                    && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // Average and count per route. Only the onRatingWritten function writes it.
    match /routeStats/{routeId} {
      allow read: if true;
      allow write: if false;
    }

    // Log of sent emails, for the admin dashboard. Only functions write it.
    match /emailLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Log of role changes. Only the setUserRole function writes it.
    match /roleChanges/{changeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // rateLimits has no rule, so browsers cannot read or write it at all.

    // Ratings. Doc id is {uid}_{routeId}, so one rating per user per route.
    match /ratings/{ratingId} {
      // Public, so everyone can see scores.
      allow read: if true;

      allow create, update: if isSignedIn()
                    // Only these fields.
                    && request.resource.data.keys().hasOnly(['uid', 'routeId', 'score', 'comment', 'updatedAt'])
                    // Only under your own uid, and the doc id must match.
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.routeId is int
                    && ratingId == request.auth.uid + '_' + string(request.resource.data.routeId)
                    // Score 1 to 5.
                    && request.resource.data.score is int
                    && request.resource.data.score >= 1
                    && request.resource.data.score <= 5
                    // Comment up to 300 characters.
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 300;

      allow delete: if isAdmin();
    }

    // Everything else is blocked by default.
  }
}
